# Exemplos de variáveis de ambiente do Folio
# Dynaconf carrega automaticamente do .env e de variáveis prefixadas por FOLIO_SYNC_ ou FOLIO_MCP_

# ==========================================
# Configurações do Sincronizador (doc-sync)
# ==========================================

# Qual provedor de embeddings utilizar? (none, ollama, fastembed, openai)
FOLIO_SYNC_EMBEDDER="ollama"
FOLIO_SYNC_EMBEDDER_MODEL="nomic-embed-text"

# Tamanhos dos chunks para a quebra de documentos
FOLIO_SYNC_CHUNK_SIZE="512"
FOLIO_SYNC_CHUNK_MAX_SIZE="1024"

# ==========================================
# Configurações do MCP Server
# ==========================================
# Se precisar sobrescrever opções locais ou limitar resultados:
# FOLIO_MCP_SEARCH__DEFAULT_LIMIT="10"
# FOLIO_MCP_SEARCH__MAX_LIMIT="50"

# ==========================================
# Dependências Externas
# ==========================================
# URL base do Ollama (caso não esteja rodando em http://localhost:11434)
# OLLAMA_HOST="http://localhost:11434"
