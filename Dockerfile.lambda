FROM python:3.14-rc-slim

# Install Lambda Web Adapter
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.8.4 /opt/extensions/lambda-adapter /opt/extensions/lambda-adapter

ENV PORT=8080
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

# Install uv
RUN pip install uv

WORKDIR /app

# Copy dependency files for workspace
COPY pyproject.toml uv.lock .python-version ./
COPY packages/mcp-server/pyproject.toml packages/mcp-server/
COPY packages/core/pyproject.toml packages/core/
COPY packages/sync/pyproject.toml packages/sync/

# Sync dependencies
RUN uv sync --frozen --no-install-project

# Copy project code
COPY . /app

# Final sync
RUN uv sync --frozen

# Start the SSE server
CMD ["uv", "run", "python", "-c", "from folio_mcp.handler import mcp; mcp.run(transport='sse', host='0.0.0.0', port=8080)"]
